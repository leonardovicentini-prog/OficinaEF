@model Categoria

@{
    ViewData["Title"] = "Excluir categoria";
    bool temProdutos = Model.Produtos.Count > 0;
}

<h1>Excluir categoria</h1>

@if (temProdutos)
{
    <div class="alert alert-danger">
        Esta categoria tem @Model.Produtos.Count produto(s) e não pode ser excluída.
        Mova ou exclua os produtos antes.
    </div>
}
else
{
    <div class="alert alert-warning">
        Tem certeza de que deseja excluir
        esta categoria?
    </div>
}

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Descrição</dt>
    <dd class="col-sm-10">@Model.Descricao</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input asp-for="Id" type="hidden" />

    @if (!temProdutos)
    {
        <button type="submit"
                class="btn btn-danger">
            Confirmar exclusão
        </button>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>
