@model IEnumerable<Produto>

@{
    ViewData["Title"] = "Produtos";
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="d-flex justify-content-between
            align-items-center mb-3">
    <div>
        <h1>Produtos</h1>
        @if (ViewBag.CategoriaFiltro is not null)
        {
            <p class="text-muted mb-0">
                Categoria: <strong>@ViewBag.CategoriaFiltro</strong> ·
                <a asp-action="Index">ver todos</a>
            </p>
        }
    </div>

    <a asp-action="Create"
       class="btn btn-success">
        Novo produto
    </a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Erro"]
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Produto produto in Model)
            {
                <tr>
                    <td>@produto.Nome</td>
                    <td>@produto.Categoria?.Nome</td>
                    <td>@produto.Preco.ToString("C", br)</td>
                    <td>@produto.Estoque</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@produto.Id"
                           class="btn btn-primary btn-sm">
                            Detalhes
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@produto.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@produto.Id"
                           class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
