@model Produto

@{
    ViewData["Title"] = "Detalhes do produto";
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<h1>
    Detalhes do produto
</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Categoria</dt>
    <dd class="col-sm-10">@Model.Categoria?.Nome</dd>

    <dt class="col-sm-2">Descrição curta</dt>
    <dd class="col-sm-10">@Model.Descricao</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">@Model.Preco.ToString("C", br)</dd>

    @if (Model.PrecoAntigo.HasValue)
    {
        <dt class="col-sm-2">Preço antigo</dt>
        <dd class="col-sm-10">@Model.PrecoAntigo.Value.ToString("C", br)</dd>
    }

    <dt class="col-sm-2">Estoque</dt>
    <dd class="col-sm-10">@Model.Estoque</dd>

    <dt class="col-sm-2">Selo</dt>
    <dd class="col-sm-10">@Model.Selo</dd>

    <dt class="col-sm-2">Imagem</dt>
    <dd class="col-sm-10">@Model.ImagemUrl</dd>
</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Editar
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Voltar
</a>
