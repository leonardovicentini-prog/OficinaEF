@model Produto

@{
    ViewData["Title"] = "Editar produto";
}

<h1>Editar produto</h1>

<form asp-action="Edit" method="post">
    <partial name="_Form" model="Model" />

    <button type="submit"
            class="btn btn-warning">
        Salvar alterações
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
