@model Produto

@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div asp-validation-summary="ModelOnly"
     class="text-danger"></div>

@if (Model.Id > 0)
{
    <input asp-for="Id" type="hidden" />
}

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Nome"
               class="form-label"></label>
        <input asp-for="Nome"
               class="form-control" />
        <span asp-validation-for="Nome"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="CategoriaId"
               class="form-label"></label>
        <select asp-for="CategoriaId"
                asp-items="ViewBag.Categorias"
                class="form-select">
            <option value="0">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId"
              class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Descricao"
           class="form-label"></label>
    <input asp-for="Descricao"
           class="form-control" />
    <span asp-validation-for="Descricao"
          class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Preco"
               class="form-label"></label>
        <input asp-for="Preco"
               type="number" step="0.01" min="0.01"
               value="@(Model.Preco > 0 ? Model.Preco.ToString("0.00", inv) : "")"
               class="form-control" />
        <span asp-validation-for="Preco"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="PrecoAntigo"
               class="form-label"></label>
        <input asp-for="PrecoAntigo"
               type="number" step="0.01" min="0.01"
               value="@(Model.PrecoAntigo?.ToString("0.00", inv))"
               class="form-control" />
        <span asp-validation-for="PrecoAntigo"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Estoque"
               class="form-label"></label>
        <input asp-for="Estoque"
               class="form-control" />
        <span asp-validation-for="Estoque"
              class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Selo"
               class="form-label"></label>
        <select asp-for="Selo"
                class="form-select">
            <option value="">Sem selo</option>
            <option value="NOVO">NOVO</option>
            <option value="PROMO">PROMO</option>
            <option value="ÚLTIMAS">ÚLTIMAS</option>
            <option value="LIMITADO">LIMITADO</option>
        </select>
        <span asp-validation-for="Selo"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Arte"
               class="form-label"></label>
        <select asp-for="Arte"
                class="form-select">
            <option value="">Nenhuma</option>
            <option value="keyboard">Teclado</option>
            <option value="chair">Cadeira</option>
            <option value="headset">Headset</option>
            <option value="mouse">Mouse</option>
            <option value="game">Game (caixa)</option>
            <option value="desk">Mesa</option>
        </select>
        <div class="form-text">Usada na Home enquanto não houver imagem.</div>
        <span asp-validation-for="Arte"
              class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="ImagemUrl"
               class="form-label"></label>
        <input asp-for="ImagemUrl"
               class="form-control"
               placeholder="/img/produtos/teclado.jpg" />
        <span asp-validation-for="ImagemUrl"
              class="text-danger"></span>
    </div>
</div>
